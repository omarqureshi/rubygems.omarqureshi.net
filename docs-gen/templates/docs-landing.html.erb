<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>API Reference — Ruby</title>
<link rel="stylesheet" href="//rubygems.omarqureshi.net/styles/theme.css">
<link rel="stylesheet" href="//rubygems.omarqureshi.net/styles/docs-index.css">
</head><body><div class="wrap">
  <nav class="cdk-crumb"><span class="cur">API Reference</span></nav>
  <h1>API Reference for <span class="r">Ruby</span></h1>
  <p class="sub">Generated from the same jsii assemblies the TypeScript, Python, Java, C# and Go bindings are generated from.</p>

  <h2 class="m-title" id="libraries">Libraries <span class="ct"><%= libraries.size %></span></h2>
  <ul class="lib-list">
<% libraries.each do |lib| -%>
    <li>
      <a href="<%= h.(lib[:name]) %>/"><%= h.(lib[:name]) %></a>
      <span class="ver"><%= h.(lib[:version]) %></span>
<% if lib[:blurb] -%>
      <p><%= h.(lib[:blurb]) %></p>
<% end -%>
    </li>
<% end -%>
  </ul>

  <p class="foot-note">Each link goes to the current version. Every release keeps
  its own permanent URL — <code>/docs/&lt;Library&gt;/&lt;version&gt;/</code> — so
  a page you link to today keeps saying what it said today.</p>
</div></body></html>
