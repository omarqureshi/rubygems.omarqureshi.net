<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= h.(title) %> — API Reference</title>
<link rel="stylesheet" href="//rubygems.omarqureshi.net/styles/theme.css">
<link rel="stylesheet" href="//rubygems.omarqureshi.net/styles/docs-index.css">
</head><body><div class="wrap">
  <nav class="cdk-crumb"><a href="/docs/">API Reference</a> <span class="sep">/</span> <span class="cur"><%= h.(root_module) %></span></nav>
  <h1><%= h.(title) %> for <span class="r">Ruby</span></h1>
<% if tagline -%>
  <p class="sub"><%= h.(tagline) %></p>
<% end -%>

<% if intro_html || getting_started || !conventions.empty? -%>
  <section class="start">
<% if intro_html -%>
    <%= intro_html %>
<% end -%>
<% if getting_started -%>
    <h2 id="getting-started">Getting started</h2>
<% getting_started.each do |heading, snippet_html| -%>
    <h3><%= h.(heading) %></h3>
    <%= snippet_html %>
<% end -%>
<% end -%>
<% unless conventions.empty? -%>
    <h3>Naming rules</h3>
    <p>The conventions you'll rely on reading these docs:</p>
    <ul>
<% conventions.each do |rule| -%>
      <li><%= rule %></li>
<% end -%>
    </ul>
<% end -%>
  </section>
<% end -%>
<% unless core_groups.empty? -%>
  <h2 class="m-title" id="core">Core types <span class="ct"><%= core_count %></span></h2>
<% core_groups.each do |grp| -%>
  <h3 class="core-sub"><%= grp[:label] %> <span class="ct"><%= grp[:count] %></span></h3>
  <div class="cols">
<% grp[:items].each do |c| -%>
    <a class="m live" href="<%= c[:href] %>"><%= h.(root_module) %>::<%= h.(c[:name]) %></a>
<% end -%>
  </div>
<% end -%>
<% end -%>
<% unless modules.empty? -%>
  <h2 class="m-title" id="modules">Modules</h2>
  <div class="cols">
<% modules.each do |m| -%>
<% if m[:live] -%>
    <a class="m live" href="<%= m[:leaf] %>/index.html"><%= h.(m[:name]) %></a>
<% else -%>
    <span class="m"><%= h.(m[:name]) %></span>
<% end -%>
<% end -%>
  </div>
<% end -%>
  <footer>Generated on <%= generated_on %>.</footer>
</div></body></html>
